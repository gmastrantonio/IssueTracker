@page "/tickets"
@using IssueTracker.Core.DTOs
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using IssueTracker.Client.Services
@using IssueTracker.Client.Services.Interfaces
@inject ITicketService ticketService
@inject HttpClient Http
@attribute [Authorize]
<!-- attribute [Authorize(Roles = "Admin,Technician")] per specifica ruoli-->
<PageTitle>Dashboard Ticket</PageTitle>

<style>
    /* Overlay semi-trasparente per il caricamento */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5); /* Nero semi-trasparente */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 9999; /* Si assicura di stare sopra a tutto */
        color: white;
    }
</style>

@* Overlay mostrato solo quando isUpdating è true *@
@if (isUpdating)
{
    <div class="loading-overlay">
        <div class="spinner-border text-light mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
        <span class="fs-5 fw-bold">Eliminazione in corso...</span>
    </div>
}

@* Overlay mostrato solo quando isUpdating è true *@
@if (isUpdated)
{
    <div class="loading-overlay">
        <div class="text-light mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
        <span class="fs-5 fw-bold">@deleteMessage</span>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestione Segnalazioni</h2>
        <a href="/tickets/new" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuovo Ticket
        </a>
    </div>

    @if (tickets == null)
    {
        <div class="d-flex align-items-center justify-content-center my-5">
            <div class="spinner-border text-primary me-3" role="status"></div>
            <span>Caricamento dei ticket in corso...</span>
        </div>
    }
    else if (!tickets.Any())
    {
        <div class="alert alert-info" role="alert">
            Non è presente alcun ticket nel sistema. Clicca su "Nuovo Ticket" per creare il primo!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Titolo</th>
                        <th>Priorità</th>
                        <th>Stato</th>
                        <th>Creato il</th>
                        <th>Autore</th>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <th>Elimina</th>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in tickets)
                    {
                        <tr>
                            <td><strong>#@ticket.Id</strong></td>
                            <td>
                                <div class="fw-bold">@ticket.Title</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 300px;">
                                    @ticket.Description
                                </small>
                            </td>
                            <td>
                                <span class="badge @GetPriorityBadgeClass(ticket.Priority)">
                                    @ticket.Priority
                                </span>
                            </td>
                            <td>
                                @* Sostituiamo il badge statico con una select interattiva *@
                                <select class="form-select form-select-sm"
                                        value="@ticket.Status"
                                        @onchange="@(async (e) => await UpdateTicketStatus(ticket, e.Value?.ToString()))">
                                    @foreach (var statusName in Enum.GetNames<IssueTracker.Core.Models.TicketStatus>())
                                    {
                                        <option value="@statusName">@statusName</option>
                                    }
                                </select>
                            </td>
                            <td>@ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@ticket.AuthorName</td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <td>
                                        <button type="button" class="btn btn-danger" disabled="@isUpdating"
                                                @onclick="@(async (e) => await DeleteTicket(ticket.Id))">
                                            Elimina
                                        </button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<TicketResponseDto>? tickets;
    private bool isUpdating = false; // Stato per gestire l'overlay di caricamento
    private bool isUpdated = false;
    private string deleteMessage = "";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Eseguiamo la chiamata GET asincrona verso l'endpoint /api/tickets del nostro controller
            tickets = await Http.GetFromJsonAsync<List<TicketResponseDto>>("api/tickets");
        }
        catch (Exception ex)
        {
            // In caso di errore di connessione, impostiamo una lista vuota per non bloccare l'UI
            tickets = new List<TicketResponseDto>();
            Console.WriteLine($"Errore durante il recupero dei ticket: {ex.Message}");
        }
    }

    private string GetPriorityBadgeClass(string priority) => priority switch
    {
        "Low" => "bg-secondary",
        "Medium" => "bg-info text-dark",
        "High" => "bg-warning text-dark",
        "Urgent" => "bg-danger",
        _ => "bg-light text-dark"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "New" => "bg-primary",
        "InProgress" => "bg-warning text-dark",
        "Resolved" => "bg-success",
        "Closed" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private async Task UpdateTicketStatus(TicketResponseDto ticket, string? newStatusStr)
    {
        if (string.IsNullOrEmpty(newStatusStr) || ticket.Status == newStatusStr) return;

        // Convertiamo la stringa nell'Enum corretto
        if (Enum.TryParse<IssueTracker.Core.Models.TicketStatus>(newStatusStr, out var parsedStatus))
        {
            // Prepariamo il DTO per l'aggiornamento
            var updateDto = new UpdateTicketDto
            {
                Title = ticket.Title,
                Description = ticket.Description,
                // Convertiamo anche la priorità corrente da stringa a Enum
                Priority = Enum.Parse<IssueTracker.Core.Models.TicketPriority>(ticket.Priority),
                Status = parsedStatus
            };

            try
            {
                // Invochiamo il metodo PUT sulle API
                //var response = await Http.PutAsJsonAsync($"api/tickets/{ticket.Id}", updateDto);
                var response = await ticketService.UpdateTicketAsync(ticket.Id, updateDto);
                if (response)
                {
                    // Aggiorniamo lo stato locale così l'interfaccia si allinea senza ricaricare la pagina
                    ticket.Status = newStatusStr;
                    Console.WriteLine($"Ticket #{ticket.Id} aggiornato con successo a {newStatusStr}!");
                }
                else
                {
                    Console.WriteLine("Errore durante l'aggiornamento del ticket sul server.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Errore di rete: {ex.Message}");
            }
        }
    }

    private async Task DeleteTicket(int ticketId)
    {
        try
        {
            isUpdating = true;
            var response = await ticketService.DeleteTicketAsync(ticketId);
            ShowMessageDelete(response);
            if (response)
            {
                tickets.RemoveAll(t => t.Id == ticketId);
                Console.WriteLine($"Ticket {ticketId} eliminato correttamente!");
            }
            else
            {
                Console.WriteLine($"Errore nella cancellazione del ticket {ticketId}");
            }
        }catch(Exception)
        {
            Console.WriteLine("Errore nella cancellazione");
        }
        isUpdating = false;
    }

    private async Task ShowMessageDelete(bool result)
    {
        if (result)
        {

            deleteMessage = "Ticket correttamente eliminato";
        }
        else
        {
            deleteMessage = "Si è verificato un problema durante la cancellazione!";
        }
        isUpdated = true;
        await Task.Delay(5000);
        isUpdated = false;
        StateHasChanged();

    }
}